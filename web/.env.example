# ---------------------------------------------------------------------------
# twog web — environment template. Copy to .env.local and fill in real values.
# ---------------------------------------------------------------------------

# --- WorkOS AuthKit (headless) ---------------------------------------------
# From the WorkOS dashboard (https://dashboard.workos.com).
WORKOS_API_KEY=sk_example_...
WORKOS_CLIENT_ID=client_example_...

# Password used to encrypt the session cookie. Generate with:
#   openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=replace_with_a_32_byte_random_string

# Redirect URI registered in WorkOS. Must match your /callback route exactly.
# AuthKit reads the SERVER-side var; the NEXT_PUBLIC_ copy is its client fallback.
# Keep both in sync (same value).
WORKOS_REDIRECT_URI=http://localhost:3000/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# --- Data source ------------------------------------------------------------
# "true"  -> use bundled mock fixtures (default for v1; no live backend).
# "false" -> fetch from NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_USE_MOCKS=true

# Base URL of the real backend API (used only when NEXT_PUBLIC_USE_MOCKS=false).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
